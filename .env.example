# Get a token from @BotFather in Telegram, then copy this file to .env
BOT_TOKEN=

# Only for the Cloudflare Worker: any long random string (letters, digits, _ and -).
# Telegram sends it with every webhook call so the Worker can reject other callers.
WEBHOOK_SECRET=

# Telegram username (without @) that becomes the bot's admin the first time it
# messages the bot. After that the admin is tied to that account's numeric ID.
ADMIN_USERNAME=
